{
  "name": "soinproduction-gutenberg",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./tooling/*": "./tooling/*",
    "./source/*": "./*",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*.css": "./dist/*.css",
    "./*.php": "./dist/*.php",
    "./*.json": "./dist/*.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.js"
  ],
  "peerDependencies": {
    "next": ">=16 <17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/luxon3": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/postcss": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.25.0",
    "htmlparser2": "^12.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "luxon": "3.7.2",
    "postcss": "^8.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3"
  },
  "description": "Portable React and WordPress component kit with automatic editor, PHP and asset connections",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soinproduction/soinproduction-gutenberg.git"
  },
  "homepage": "https://github.com/soinproduction/soinproduction-gutenberg#readme",
  "bugs": {
    "url": "https://github.com/soinproduction/soinproduction-gutenberg/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "components/",
    "core/",
    "ui/",
    "admin-ui/",
    "modules/",
    "adapters/",
    "hooks/",
    "styles/",
    "schema/",
    "shared/",
    "generated/responsive.ts",
    "tooling/",
    "bootstrap.php",
    "index.tsx",
    "README.md",
    "RELEASING.md",
    "tsconfig.json"
  ],
  "bin": {
    "soinproduction-kit": "./tooling/cli.mjs"
  },
  "scripts": {
    "build": "node tooling/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "prepack": "npm run build",
    "smoke": "node tooling/smoke-package.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "^16.4.5"
  }
}
